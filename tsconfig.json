{
	"compilerOptions": {
		"suppressImplicitAnyIndexErrors": true,
		"noImplicitAny": true,
		"target": "esnext",
		"module": "esnext",
		"strict": true,
		"jsx": "preserve",
		"allowJs": true,
		"checkJs": false,
		"importHelpers": true,
		"moduleResolution": "node",
		"experimentalDecorators": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"sourceMap": true,
		"typeRoots": ["src/@type","./node_modules/@types"],
		"baseUrl": ".",
		// "types": ["webpack-env"],
		"paths": {
			"@/*": ["src/*"]
		},
		"lib": ["esnext", "dom", "dom.iterable", "scripthost"]
	},
		"typeRoots": [
  "./typings",
  "./node_modules/@types/"
],
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"src/**/*.vue",
		"tests/**/*.ts",
		"tests/**/*.tsx"
, "src/cache.js", "src/axios.js", "src/main.ts", "src/store/store.js", "src/router/index.js"	],
	"exclude": ["node_modules","src/@type/**/*"]
}
